# Copy to tools/ios/ios-signing.env and fill in values on a macOS signer host.

# Apple Developer Team ID (required for device signing attempt)
APPLE_TEAM_ID=

# Name or SHA-1 fingerprint of an installed code-sign identity in keychain.
# Example: Apple Development: Jane Doe (ABCDE12345)
IOS_CODESIGN_IDENTITY=

# Path to a signable .app bundle produced by your iOS host project.
# This repository emits iOS-targeted binaries but not a native .app bundle.
# Provide the bundle path from your host wrapper build output.
IOS_APP_BUNDLE_PATH=

